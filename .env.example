# Analytics configuration — fill these in and add them to the Netlify site settings
# (Site configuration > Environment variables).

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Falls back to the existing
# container if this is not set, so leaving it blank will not break the site.
GTM_CONTAINER_ID=GTM-XXXXXXX

# PostHog project API key from PostHog project settings. This is the PUBLIC
# client-side key that starts with `phc_`. Do NOT use a personal API key here;
# personal API keys start with `phx_` and must stay server-side.
GATSBY_POSTHOG_PROJECT_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog API host. Use https://us.i.posthog.com for US cloud projects or
# https://eu.i.posthog.com for EU cloud projects.
GATSBY_POSTHOG_API_HOST=https://us.i.posthog.com
